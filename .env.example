# 本文件只记录配置名称和安全示例，不填写真实密钥。
APP_ENV=development

# 默认使用 Mock，避免自动联网或产生模型费用。
AGENTSHIELD_MODEL_PROVIDER=mock

# 真实密钥只填写在本机 .env，绝不能填写在本文件。
AGENTSHIELD_MODEL_API_KEY=

AGENTSHIELD_MODEL_NAME=gpt-5.6-terra
AGENTSHIELD_MODEL_BASE_URL=https://api.openai.com/v1

AGENTSHIELD_API_KEY_RECORDS=[]

# 可请求的工具名称列表；默认空列表，表示不允许请求任何工具。
AGENTSHIELD_ALLOWED_TOOLS=[]

# Redis 用于按已认证租户计数；默认每 60 秒最多允许 60 次模型调用。
AGENTSHIELD_REDIS_URL=redis://127.0.0.1:6379/0
AGENTSHIELD_RATE_LIMIT_MAX_REQUESTS=60
AGENTSHIELD_RATE_LIMIT_WINDOW_SECONDS=60
